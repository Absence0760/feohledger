# Decrypted secrets — recreated by deploy.sh on every run (.env.tmp is the
# in-flight decrypt target, removed on exit).
.env
.env.tmp
# The VM's copy of the sops-encrypted secrets file. The canonical encrypted
# file is infra-secrets/feohledger/prod.sops.yaml, in the private repo — never
# in this (public) one.
prod.sops.yaml
# Per-VM tenant host list — seeded from tenants.caddy.example.
tenants.caddy
# deploy.sh's one-deploy-at-a-time lock (flock).
.deploy.lock
# The published SPA releases Caddy serves (releases/<id>, current, previous) —
# written by deploy.sh, mounted at /srv.
/www/
