# Template for the VM's secrets file — the contract deploy/decrypt-env.sh checks.
#
# The real file is infra-secrets/feohledger/prod.sops.yaml, in the PRIVATE
# infra-secrets repo, encrypted under alias/feohledger-sops. Never commit a
# copy with real values to this (public) repo, encrypted or not.
#
#   aws sso login --profile feohledger
#   cd ~/github/infra-secrets && AWS_PROFILE=feohledger sops feohledger/prod.sops.yaml
#
# sops opens an editor: paste this file, fill it in, and save — sops writes it
# encrypted (every value encrypted, keys left readable). Copy that file onto
# the VM as deploy/prod.sops.yaml; deploy.sh runs decrypt-env.sh, which
# decrypts it to deploy/.env (gitignored) on every deploy.
#
# Format:
#   - flat keys, named exactly as the env var;
#   - double-quote every value, "true" and numbers included, so YAML never
#     reinterprets one (a `0123` or `1e5` would not survive as typed);
#   - single-line values with no `$` and no ` #` — compose's env_file would
#     interpolate the first and cut the value at the second, so decrypt-env.sh
#     refuses both;
#   - a key shown commented out is optional: uncomment it only to set it.
#
# Generate keys in your own terminal. Full context: docs/minimal-deployment.md.
# The app's complete FEOH_* reference is docs/environment.md — everything not
# listed here keeps its safe default (mock adapters, local dispatch modes,
# background sweeps off).

# ── Deploy-level (consumed by compose interpolation + deploy.sh + backup.sh) ──
# URL-safe by construction: openssl rand -hex 24 (it is embedded in the DSN).
POSTGRES_PASSWORD: ""
# Bare SPA host, API host, and the ACME registration email.
APP_DOMAIN: "feohledger.com"
API_DOMAIN: "api.feohledger.com"
ACME_EMAIL: "you@example.com"
# Region for boto3 (S3 / SES) inside the api container.
AWS_REGION: "us-east-1"
# Versioned bucket the nightly backup.sh streams pg dumps into (the
# `backups_bucket` output of the infra/ Terraform module).
BACKUP_S3_BUCKET: ""
# Optional dead-man's-switch: healthchecks.io-style URL backup.sh pings after
# every successful run — silence means backups stopped. Unset = disabled.
# BACKUP_PING_URL: ""

# ── Core app config ──
FEOH_ENVIRONMENT: "production"
# openssl rand -hex 32
FEOH_SECRET_KEY: ""
# FEOH_DATABASE_URL / FEOH_REDIS_URL default to the local containers (derived in
# compose.prod.yml). Setting either here overrides the default — this is the
# entire migration path to RDS / ElastiCache later, no compose edit needed.
# FEOH_DATABASE_URL: "postgresql+asyncpg://user:pass@your-rds-host:5432/feohledger"
# FEOH_REDIS_URL: "redis://your-elasticache-host:6379"

# ── S3 (real AWS — empty endpoint/keys = instance-profile credentials) ──
FEOH_S3_BUCKET: ""
FEOH_S3_ENDPOINT_URL: ""
FEOH_S3_ACCESS_KEY: ""
FEOH_S3_SECRET_KEY: ""

# ── URLs (drive emails, SAML SP entity, tenant links, CORS) ──
FEOH_PUBLIC_URL: "https://feohledger.com"
FEOH_API_PUBLIC_URL: "https://api.feohledger.com"
FEOH_TENANT_URL_TEMPLATE: "https://{slug}.feohledger.com"
FEOH_CORS_PRODUCTION_DOMAIN: "feohledger.com"

# ── Deployed-env posture ──
FEOH_MFA_ENABLED: "true"
FEOH_HSTS_ENABLED: "true"
# Passkeys (WebAuthn) — gated by FEOH_MFA_ENABLED above; without these the
# dev defaults (localhost) reject every prod origin and passkeys silently
# fail. RP ID must be a registrable suffix of every login origin; the
# wildcard entry admits each tenant subdomain with no per-tenant env change.
FEOH_WEBAUTHN_RP_ID: "feohledger.com"
FEOH_WEBAUTHN_ORIGINS: "https://feohledger.com,https://*.feohledger.com"
# FEOH_TRUSTED_PROXY_CIDRS defaults in compose.prod.yml to the pinned compose
# subnet (172.28.0.0/16) so rate limits + audit rows see the real client
# through Caddy. Only set here to override (e.g. an external LB in front).
# FEOH_TRUSTED_PROXY_CIDRS: ""
# The region THIS stack runs in, compared against each tenant's residency pin
# and reported as the advisory `alignment` block on /api/organization/data-
# residency. Nothing routes or blocks on it (decisions.md §34), but leaving it
# empty makes every tenant's residency answer `unknown` / `aligned: null` —
# "cannot attest" rather than a verified yes. One of: us | eu | uk | ca | au.
FEOH_DEPLOYED_REGION: "us"

# ── Email (SES sandbox only sends to verified recipients — request
#    production access, or keep provider=console until it clears) ──
FEOH_EMAIL_PROVIDER: "ses"
FEOH_EMAIL_FROM: "no-reply@example.com"
FEOH_AWS_SES_REGION: "us-east-1"

# ── Invoice extraction — DECIDE BEFORE FIRST BOOT ──
# Extraction is the one integration that does NOT fall back to its mock here.
# With FEOH_ENVIRONMENT=production and neither key below set, every uploaded
# invoice's extraction fails loudly (an `extraction_failed` exception on the
# invoice), because the mock would invent fields on a real document. A tenant
# that brings its own key (BYOK, settings.extraction) is unaffected. Choose one
# (backend/docs/ai-extraction.md § Platform provider precedence):
#   - a real key — Claude Vision reads the documents, which makes Anthropic a
#     live sub-processor of tenant invoices (docs/sub-processors.md);
#   - FEOH_EXTRACTION_PROVIDER: "mock" — fabricated fields ("Extracted Vendor
#     Inc", 1500.00): a demo box with no real tenant, never anything else;
#   - neither — invoices are keyed in by hand; decrypt-env.sh warns every run.
# FEOH_ANTHROPIC_API_KEY: ""
# FEOH_EXTRACTION_PROVIDER: ""

# ── Signing keys (each key's presence is its feature's on-switch; leave a
#    key commented out to keep that feature off) — openssl rand -hex 32 each ──
FEOH_APPROVAL_SIGNING_KEY: ""
# FEOH_EMAIL_ACTION_SIGNING_KEY: ""
# FEOH_PARTNER_LINK_SIGNING_KEY: ""

# ── Self-service signup + hCaptcha ──
# FEOH_SIGNUP_ENABLED is the switch. "false" closes signup: every /api/signup/*
# route answers 404, /signup says signup is closed, and neither hCaptcha key is
# needed — the right setting for a pilot whose tenants come from add-tenant.sh.
# Delete the line (or set "true") to open public signup; then the hCaptcha
# SECRET is REQUIRED — FEOH_ENVIRONMENT=production refuses to boot without it
# (config.py _require_captcha_in_deployed_envs), and decrypt-env.sh refuses
# before it gets that far — and the SITEKEY must be set for the widget to render.
# docs/self-service-signup.md § Turning signup off.
FEOH_SIGNUP_ENABLED: "false"
# FEOH_HCAPTCHA_SECRET: ""
# FEOH_HCAPTCHA_SITEKEY: ""
