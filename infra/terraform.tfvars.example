# Template for this module's variables. Nothing in here is secret, but a
# filled copy is operator config (bucket names, alert addresses), so it is never
# committed to this public repo: keep the canonical copy in the private
# infra-secrets repo and pass it with -var-file — see README.md.

# Primary AWS region.
aws_region = "us-east-1"

# Project name used for tagging and resource naming.
project = "feohledger"

# Environment (prod, staging, etc.). Becomes part of resource names + tags.
environment = "prod"

# --- S3 bucket names --------------------------------------------------------
# Globally unique. Include a short random suffix so re-creation doesn't
# conflict with the bucket name's 30-day cooldown (AWS keeps deleted bucket
# names reserved briefly to prevent takeover).
invoice_files_bucket_name = "feohledger-invoices-prod-REPLACE"
audit_logs_bucket_name    = "feohledger-audit-logs-prod-REPLACE"
access_logs_bucket_name   = "feohledger-access-logs-prod-REPLACE"
backups_bucket_name       = "feohledger-backups-prod-REPLACE"

# --- Object Lock retention --------------------------------------------------
# Days an object stays locked after it lands. Invoices run in Governance mode
# (legitimate override possible); audit logs run in Compliance mode (no
# override even with root). Defaults match SOC 2 expectations — override if
# your data-retention policy calls for a different number.
# invoice_retention_days = 365
# audit_retention_days   = 2555

# --- Backup retention ---------------------------------------------------------
# The backups bucket (nightly pg dumps from deploy/backup.sh) has no Object
# Lock — this lifecycle window is the whole retention/cost story.
# backup_retention_days = 90

# --- Platform domain ------------------------------------------------------------
# The registered apex the ACM certificate covers and domain.tf manages. Register
# it through Route 53 in this account first — that creates its hosted zone.
# domain_name = "feohledger.com"

# --- Cost alerts ----------------------------------------------------------------
# Every budget notification (50 % / 100 % actual, 100 % forecast) goes to these
# addresses. Required, with no default, so the real address never lands in this
# public repo — and the example.com placeholder is rejected on plan.
budget_alert_emails = ["alerts@example.com"]
# monthly_budget_limit_usd = 25

# --- Email ------------------------------------------------------------------------
# Mailboxes on Migadu, app mail through SES (email.tf, README.md § Email). The
# token is shown at admin.migadu.com → Domains → <domain> after adding the
# domain there; leave it unset until then. The DMARC address is published in
# DNS and must be a mailbox on the platform domain.
# migadu_verification_token = "REPLACE"
# dmarc_report_email        = "ops@feohledger.com"
# dmarc_policy              = "none"   # raise to "quarantine" once reports align

# --- Secrets ------------------------------------------------------------------
# None, and a secret never goes in a tfvars. When the ECS/ALB/RDS stack lands,
# its secrets (rds_master_password, …) are read from the sops-encrypted
# infra-secrets/feohledger/prod.sops.yaml via the carlpett/sops provider —
# README.md § Secrets.
