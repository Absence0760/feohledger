<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Every layer is rendered from
     assets/icon-{background,foreground,monochrome}.svg by assets/gen-icons.sh;
     API 21-25 fall back to mipmap-*/ic_launcher.png. Without this file Android
     8+ shrinks the legacy PNG onto a white plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
