<?xml version="1.0" encoding="utf-8"?>
<!-- Keep identical to drawable-v21/launch_background.xml, which explains the
     layout. minSdk is 24, so that copy is the one every supported device
     reads; this one is Flutter's pre-API-21 fallback. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item android:bottom="52dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
