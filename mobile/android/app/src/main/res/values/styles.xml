<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window, shown while the process starts and until Flutter
         draws its first frame (Android 11 and below; Android 12+ reads
         values-v31/styles.xml). Light in dark mode too: see
         values-night/styles.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started. Its window background shows
         behind the Flutter UI while it initializes and wherever the Flutter
         view doesn't cover the window, so it is the Flutter window colour
         rather than the platform's. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
